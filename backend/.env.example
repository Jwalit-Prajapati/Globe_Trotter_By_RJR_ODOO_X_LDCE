# Copy this file to backend/.env and fill in real values for local (non-docker) dev.
# Used by `docker compose` when Spring Boot auto-starts backend/compose.yaml
# (spring-boot-docker-compose picks up connection details automatically).
#
# JWT_SECRET/JWT_EXPIRATION_MS/APP_CORS_ALLOWED_ORIGINS are read by application.yaml but
# are NOT auto-loaded from this file by Spring Boot itself — export them into your shell
# or IDE run configuration before running `mvn spring-boot:run`, e.g.:
#   PowerShell:  Get-Content backend/.env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { Set-Item "env:$($matches[1])" $matches[2] } }
#   bash:        set -a; source backend/.env; set +a

POSTGRES_DB=globetrotter
POSTGRES_USER=globetrotter
POSTGRES_PASSWORD=change-me

JWT_SECRET=change-me-generate-a-64-byte-base64-secret
JWT_EXPIRATION_MS=86400000
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
